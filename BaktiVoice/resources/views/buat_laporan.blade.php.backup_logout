@media (max-width: 768px) {

    /* Sidebar disembunyikan */
    .sidebar {
        display: none !important;
    }

    /* Main wrapper memenuhi layar */
    .main-wrapper {
        margin-left: 0 !important;
        width: 100% !important;
        min-width: 0;
    }

    /* Topbar HP */
    .topbar {
        height: 60px;
        padding: 0 16px;
        justify-content: space-between;
        background: linear-gradient(
            135deg,
            #dbeafe 0%,
            #bfdbfe 50%,
            #93c5fd 100%
        ) !important;
    }

    /* Penyesuaian kelompok kanan saat di HP */
    .topbar-right-group {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-left: auto;
    }

    .topbar-mobile-brand {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .topbar-logo-img {
        width: 30px;
        height: 30px;
        object-fit: contain;
    }

    .topbar-brand-name {
        font-size: 15px;
        font-weight: 700;
        color: #0f172a;
    }

    .user-name {
        display: none !important;
    }

    /* Konten */
    .content {
        padding: 16px;
        padding-bottom: 90px;
        min-width: 0;
    }

    .report-card {
        width: 100%;
        max-width: 100%;
        padding: 24px;
    }

    /* Privasi */
    .privacy-options {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
    }

    /* Tombol */
    .form-bottom {
        padding-right: 0;
    }

    /* Bottom navigation */
    .mobile-bottom-nav {
        display: flex;
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background: linear-gradient(
            135deg,
            #dbeafe 0%,
            #bfdbfe 50%,
            #93c5fd 100%
        );
        border-top: 1px solid #93c5fd;
        justify-content: space-around;
        align-items: center;
        padding: 8px 4px;
        padding-bottom: max(8px, env(safe-area-inset-bottom));
        z-index: 1000;
        box-shadow: 0 -4px 15px rgba(147, 197, 253, 0.4);
    }

    .mobile-bottom-nav a {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: #1e3a8a;
        font-size: 9.5px;
        font-weight: 600;
        gap: 4px;
        opacity: 0.75;
        min-width: 0;
    }

    .mobile-bottom-nav a i {
        font-size: 18px;
    }

    .mobile-bottom-nav a.active,
    .mobile-bottom-nav a:hover {
        opacity: 1;
        color: #0f172a;
    }

    .mobile-logout-link i,
    .mobile-logout-link span {
        color: #e11d48;
    }
}

@media (max-width: 550px) {

    .content {
        padding: 16px;
        padding-bottom: 90px;
    }

    .page-title {
        font-size: 22px;
        margin-bottom: 18px;
    }

    .report-card {
        padding: 18px;
    }

    .form-input,
    .form-select {
        font-size: 14px;
        width: 100%;
    }

    .form-textarea {
        min-height: 120px;
    }

    .upload-area {
        height: 150px;
        padding: 12px;
        text-align: center;
    }

    .upload-text {
        font-size: 13px;
    }

    .upload-format {
        font-size: 11px;
    }

    .form-bottom {
        margin-top: 25px;
        padding-right: 0;
    }

    .btn-submit {
        width: 100%;
        min-width: 0;
        height: 48px;
    }
}

/* FIX TOPBAR DESKTOP */
@media (min-width: 769px) {
    .topbar {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: flex-end !important;
    }

    .topbar-right-group {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: flex-end !important;
        gap: 20px !important;
        margin-left: auto !important;
        height: 100%;
    }

    .topbar-right-group .topbar-icon,
    .topbar-right-group .user-profile {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        margin: 0 !important;
    }
}
/* INDIKATOR NOTIFIKASI BELUM DIBACA */
.notification-icon-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
}

.unread-notification-dot {
    position: absolute;
    top: -3px;
    right: -4px;
    width: 9px;
    height: 9px;
    border: 2px solid #ffffff;
    border-radius: 50%;
    background: #22c55e;
    box-sizing: content-box;
    z-index: 5;
    pointer-events: none;
}

