@media (max-width: 768px) {

    /* SIDEBAR */
    .sidebar {
        display: none !important;
    }

    /* MAIN WRAPPER */
    .main-wrapper {
        margin-left: 0;
        width: 100%;
        min-height: 100vh;
    }

    /* TOPBAR */
    .topbar {
        height: 60px;
        padding: 0 16px;
        justify-content: space-between;
        gap: 10px;

        background: linear-gradient(
            135deg,
            #dbeafe 0%,
            #bfdbfe 50%,
            #93c5fd 100%
        );
    }

    /* Penyesuaian kelompok kanan saat di HP */
    .topbar-right-group {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-left: auto;
    }

    .topbar-mobile-brand {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .topbar-mobile-brand img {
        width: 30px;
        height: 30px;
        object-fit: contain;
        border-radius: 8px;
    }

    .topbar-mobile-brand span {
        font-size: 15px;
        font-weight: 800;
        color: #1e3a70;
    }

.topbar-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #274472;
    font-size: 18px;
    padding: 8px;
    flex-shrink: 0;
}

    .user-name {
        display: none;
    }

    /* CONTENT */
    .content {
        padding: 20px 16px 90px;
    }

    .page-title {
        font-size: 25px;
        margin-bottom: 20px;
    }

    .search-wrapper {
        margin-bottom: 20px;
    }

    /* REPORT CARD */
    .report-card {
        display: grid;
        grid-template-columns: 42px minmax(0, 1fr) auto;
        grid-template-areas:
            "image info arrow"
            "image status arrow";

        align-items: center;
        gap: 8px 10px;
        padding: 14px;
    }

    .report-image {
        grid-area: image;
        width: 42px;
        height: 42px;
    }

    .report-info {
        grid-area: info;
        min-width: 0;
    }

    .report-title {
        font-size: 13px;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    .report-date {
        font-size: 11px;
    }

    .report-status {
        grid-area: status;
        justify-self: start;
        min-width: auto;
        padding: 5px 9px;
        font-size: 10px;
    }

    .report-arrow {
        grid-area: arrow;
        width: 24px;
    }

    /* MOBILE BOTTOM NAVIGATION */
    .mobile-bottom-nav {
        display: flex;
        align-items: center;
        justify-content: space-around;

        position: fixed;
        bottom: 0;
        left: 0;

        width: 100%;
        min-height: 66px;

        background: linear-gradient(
            135deg,
            #dbeafe 0%,
            #bfdbfe 50%,
            #93c5fd 100%
        );

        border-top: 1px solid #93c5fd;
        box-shadow: 0 -3px 12px rgba(123, 159, 232, 0.12);

        z-index: 1000;
        padding: 7px 3px;
    }

    .mobile-bottom-nav a {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;

        color: #274472;
        text-decoration: none;
        font-size: 9.5px;
        font-weight: 600;

        min-width: 0;
    }

    .mobile-bottom-nav a i {
        font-size: 18px;
    }

    .mobile-bottom-nav a.active {
        color: #315ca8;
        font-weight: 800;
    }

    .mobile-bottom-nav a.active i {
        color: #315ca8;
    }
}

@media (max-width: 550px) {

    .page-title {
        font-size: 24px;
    }

    .content {
        padding: 18px 14px 90px;
    }

    .report-card {
        padding: 12px;
        gap: 7px 9px;
    }

    .report-title {
        font-size: 12px;
    }

    .report-date {
        font-size: 10px;
    }

    .report-status {
        font-size: 9px;
        padding: 5px 8px;
    }

    .report-arrow {
        width: 20px;
    }
}

