@media (max-width: 1000px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 768px) {
    /* 1. Sembunyikan sidebar & tombol logout di sidebar */
    .sidebar {
        display: none !important;
    }

    .logout-btn {
        display: none !important;
    }

    /* 2. Lebarkan main-wrapper ke seluruh layar */
    .main-wrapper {
        margin-left: 0 !important;
        width: 100% !important;
    }

    .content {
        padding: 16px;
        padding-bottom: 90px;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    /* 3. Topbar Khusus HP */
    .topbar {
        height: 60px;
        padding: 0 16px;
        background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 50%, #93c5fd 100%) !important;
    }

    .topbar-mobile-brand {
        display: flex !important;
        align-items: center;
        gap: 8px;
        margin-right: auto;
}

    .topbar-logo-img {
        width: 30px !important;
        height: 30px !important;
        object-fit: contain;
    }

    .topbar-brand-name {
        font-weight: 700;
        font-size: 15px;
        color: #0f172a;
    }

    /* Sembunyikan nama panjang di topbar HP */
    .user-name {
        display: none !important;
    }

    /* 4. Tampilkan Bottom Navbar di HP dengan Background Biru Gradasi */
    .mobile-bottom-nav {
        display: flex !important;
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 50%, #93c5fd 100%) !important;
        border-top: 1px solid #93c5fd;
        justify-content: space-around;
        align-items: center;
        padding: 8px 4px;
        z-index: 1000;
        box-shadow: 0 -4px 15px rgba(147, 197, 253, 0.4);
    }

    .mobile-bottom-nav a {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        color: #1e3a8a;
        font-size: 9.5px;
        font-weight: 600;
        gap: 4px;
        opacity: 0.75;
        transition: opacity 0.2s ease;
    }

    .mobile-bottom-nav a i {
        font-size: 18px;
    }

    .mobile-bottom-nav a.active,
    .mobile-bottom-nav a:hover {
        opacity: 1;
        color: #0f172a;
    }
}

@media (max-width: 550px) {
    /* 1. Ubah Statistik jadi 2 Kolom + Kartu ke-5 melebar penuh */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }
    .stats-grid .stat-card:last-child {
        grid-column: span 2;
    }

    .welcome-title {
        font-size: 24px;
    }

    /* 2. Atur Report Card agar tidak berhimpitan di HP kecil */
    .report-card {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
        padding: 16px;
    }

    .report-info-group {
        width: 100%;
    }

    /* Posisi badge status biar rapi di bawah judul saat layar sempit */
    .report-card .status-badge {
        align-self: flex-start;
    }
}



